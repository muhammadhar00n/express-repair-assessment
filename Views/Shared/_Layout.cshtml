<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Express Repair CRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
    <div class="container"><a class="navbar-brand" asp-controller="Home" asp-action="Index">Express Repair CRM</a>
        <div class="navbar-nav"><a class="nav-link" asp-controller="Customers" asp-action="Index">Customers</a><a class="nav-link" asp-controller="Notifications" asp-action="Index">Notifications</a></div>
    </div>
</nav>
<main class="container">@RenderBody()</main>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
